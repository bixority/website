{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WebsiteAndStateBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::bixority-website-${account_id}",
        "arn:aws:s3:::bixority-website-${account_id}/*",
        "arn:aws:s3:::bixority-tfstate-${account_id}",
        "arn:aws:s3:::bixority-tfstate-${account_id}/*"
      ]
    },
    {
      "Sid": "CloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    },
    {
      "Sid": "CertificatesForCloudFront",
      "Effect": "Allow",
      "Action": "acm:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
